# APsystems OpenAPI Credentials
# Obtenha com apisupport@apsystems.com
APSYSTEMS_APP_ID="your_app_id_here_32_chars"
APSYSTEMS_APP_SECRET="your_app_secret_12_chars"

# System ID (sid) cadastrado na plataforma EMA
APSYSTEMS_SYSTEM_ID=""

# Base URL da OpenAPI APsystems
APSYSTEMS_BASE_URL="https://api.apsystemsema.com:9282"

# Configurações do Banco de Dados Local
DATABASE_URL="sqlite:///data/solar_hub.db"

# Modo daemon integrado (inicia o coletor em background com a interface web)
ENABLE_DAEMON="true"

# Sistema de Alertas e Notificações (Opcional - deixe vazio se não for usar)
# Webhook genérico (Discord, Slack, n8n, Home Assistant, etc.)
ALERT_WEBHOOK_URL=""

# Telegram Bot (via Telegram Bot API)
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""

# Parâmetros de Alerta & Cooldown
ALERT_COOLDOWN_HOURS="4"
ALERT_MIN_HEALTH_SCORE="80"
ALERT_QUOTA_WARNING_PCT="85.0"
ALERT_MIDDAY_CHECK="true"

# Integração MQTT & Home Assistant Discovery (Opcional)
MQTT_ENABLED="false"
MQTT_BROKER="homeassistant.local"
MQTT_PORT="1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_DISCOVERY_PREFIX="homeassistant"
MQTT_TOPIC_PREFIX="solarhub"

# ==============================================================================
# Segurança & Blindagem de Hospedagem em VPS
# ==============================================================================
# Proteção por Senha (HTTP Basic Auth para Dashboard Web e API)
# Se definidos, o acesso ao painel e à API exigirá usuário e senha no navegador/cliente
AUTH_USERNAME=""
AUTH_PASSWORD=""

# Chave secreta de API para integrações externas (header X-API-Key ou Bearer Token)
API_KEY=""

# Restrição de domínios CORS (ex: "https://solar.seudominio.com" ou "*" para local)
CORS_ORIGINS="*"

# Proteção anti-SSRF: Bloqueia webhooks para IPs privados e metadados de nuvem.
# Mantenha 'false' ao hospedar em VPS pública. Ative 'true' apenas se usar webhook na LAN doméstica.
ALLOW_PRIVATE_WEBHOOKS="false"

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
