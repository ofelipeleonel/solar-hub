# APsystems OpenAPI Credentials
# Obtenha com apisupport@apsystems.com
APSYSTEMS_APP_ID="your_app_id_here_32_chars"
APSYSTEMS_APP_SECRET="your_app_secret_12_chars"

# System ID (sid) cadastrado na plataforma EMA
APSYSTEMS_SYSTEM_ID=""

# Base URL da OpenAPI APsystems
APSYSTEMS_BASE_URL="https://api.apsystemsema.com:9282"

# Configurações do Banco de Dados Local
DATABASE_URL="sqlite:///data/solar_hub.db"

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
